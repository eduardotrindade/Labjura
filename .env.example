# ==============================================================================
# LABJURA - STACK DE GESTÃO LABORATORIAL (PATRIMÔNIO, ESTOQUE & ATENDIMENTO)
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMÍNIOS & HOSTS (Localmente use localhost ou IPs, na VPS use seus subdomínios)
# ------------------------------------------------------------------------------
DOMAIN_GLPI=glpi.labjura.local
DOMAIN_INVENTREE=estoque.labjura.local
DOMAIN_CHATWOOT=atendimento.labjura.local

# ------------------------------------------------------------------------------
# PORTAS LOCAIS EXPOSTAS
# ------------------------------------------------------------------------------
PORT_GLPI=8080
PORT_INVENTREE=8081
PORT_CHATWOOT=3000

# ------------------------------------------------------------------------------
# BANCO DE DADOS MARIADB (GLPI)
# ------------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=mariadb_root_secret_change_me
MARIADB_DATABASE=glpidb
MARIADB_USER=glpi_user
MARIADB_PASSWORD=glpi_password_change_me

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (INVENTREE & CHATWOOT)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secret_change_me

# InvenTree Database
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree_user
INVENTREE_DB_PASSWORD=inventree_secret_change_me

# Chatwoot Database
CHATWOOT_DB_NAME=chatwoot_production
CHATWOOT_DB_USER=chatwoot_user
CHATWOOT_DB_PASSWORD=chatwoot_secret_change_me

# ------------------------------------------------------------------------------
# REDIS (CACHE & FILAS)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_secret_change_me

# ------------------------------------------------------------------------------
# INVENTREE CONFIGURAÇÃO
# ------------------------------------------------------------------------------
INVENTREE_SECRET_KEY=inventree_generate_a_random_secret_key_here
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=admin_password_change_me
INVENTREE_ADMIN_EMAIL=admin@labjura.com.br
INVENTREE_BACKUP_ENABLE=True

# ------------------------------------------------------------------------------
# CHATWOOT CONFIGURAÇÃO
# ------------------------------------------------------------------------------
SECRET_KEY_BASE=chatwoot_generate_a_secure_random_hex_string_64_bytes
FRONTEND_URL=http://localhost:3000
NODE_ENV=production
RAILS_ENV=production
INSTALLATION_ENV=docker
ENABLE_ACCOUNT_SIGNUP=false

# ------------------------------------------------------------------------------
# INTEGRAÇÃO N8N (VPS)
# ------------------------------------------------------------------------------
# URL do n8n que já está rodando na sua VPS:
N8N_VPS_URL=https://n8n.seuservidor.com
N8N_WEBHOOK_SECRET=token_secreto_webhook_n8n
